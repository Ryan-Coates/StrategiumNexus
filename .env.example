# Firebase config for optional Google sign-in / shared Campaign Mode.
# Leave all four unset (or delete this file's copy, .env.local) to run fully
# local/offline — no Firebase project required for that.
#
# See FIREBASE-SETUP.md for how to obtain these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


